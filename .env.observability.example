# Copy to .env.observability (ignored). Initialization does not enable tracing.
POLICYPILOT_OBSERVABILITY_ENABLED=0
POLICYPILOT_OTEL_ENDPOINT=http://127.0.0.1:14318/v1/traces
POLICYPILOT_OTEL_TOKEN=replace-with-generated-local-token
POLICYPILOT_TRACE_SAMPLE_RATE=1
# Local platform only. Init generates credentials; it never enables tracing.
POLICYPILOT_LANGFUSE_LOCAL=1
LANGFUSE_BASE_URL=http://127.0.0.1:13000
LANGFUSE_PUBLIC_KEY=replace-with-project-public-key
LANGFUSE_SECRET_KEY=replace-with-project-secret-key
LANGFUSE_DB_PASSWORD=replace-with-db-password
LANGFUSE_REDIS_PASSWORD=replace-with-redis-password
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-clickhouse-password
LANGFUSE_MINIO_PASSWORD=replace-with-minio-password
LANGFUSE_SALT=replace-with-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-encryption-key
LANGFUSE_NEXTAUTH_SECRET=replace-with-nextauth-secret
LANGFUSE_ADMIN_PASSWORD=replace-with-admin-password
