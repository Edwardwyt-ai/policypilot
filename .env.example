ANTHROPIC_API_KEY=<your_key_here>
OPENAI_API_KEY=<your_key_here>
ELEVENLABS_API_KEY=<your_key_here>
DEEPGRAM_API_KEY=<your_key_here>

# Required for banking_knowledge qwen_embeddings* retrieval configs (via OpenRouter)
OPENROUTER_API_KEY=<your_key_here>

# Optional DeepSeek provider and PolicyPilot real-integration configuration
DEEPSEEK_API_KEY=<your_key_here>
POLICYPILOT_AGENT_MODEL=deepseek/deepseek-chat
POLICYPILOT_USER_MODEL=deepseek/deepseek-chat
# Optional per-node routing. Both routes reuse DEEPSEEK_API_KEY.
# Existing single-model setups remain valid when these are unset.
POLICYPILOT_LIGHT_MODEL=deepseek/deepseek-chat
POLICYPILOT_MAIN_DECISION_MODEL=deepseek/deepseek-chat
POLICYPILOT_JUDGE_MODEL=deepseek/deepseek-chat
# Set only for an intentional paid pytest integration run.
POLICYPILOT_RUN_INTEGRATION=0

# Local Laya acquisition planner. No cloud API key is required. The model is
# loaded lazily and low-confidence decisions retain the planner source hint.
POLICYPILOT_LAYA_ENABLED=1
POLICYPILOT_LAYA_MODEL=convaiinnovations/laya
POLICYPILOT_LAYA_DEVICE=cuda
POLICYPILOT_LAYA_CACHE_DIR=.cache/huggingface

# ── Voice Persona Overrides ────────────────────────────────────────────
# The default voice IDs are Sierra-internal and won't work for external users.
# Create your own voices in ElevenLabs and set the IDs here.
# See docs/voice-personas.md for a step-by-step guide.
#
# Control personas (American accents, used in "control" complexity):
# TAU2_VOICE_ID_MATT_DELANEY=<your_voice_id>
# TAU2_VOICE_ID_LISA_BRENNER=<your_voice_id>
#
# Regular personas (diverse accents, used in "regular" complexity):
# TAU2_VOICE_ID_MILDRED_KAPLAN=<your_voice_id>
# TAU2_VOICE_ID_ARJUN_ROY=<your_voice_id>
# TAU2_VOICE_ID_WEI_LIN=<your_voice_id>
# TAU2_VOICE_ID_MAMADOU_DIALLO=<your_voice_id>
# TAU2_VOICE_ID_PRIYA_PATIL=<your_voice_id>
POLICYPILOT_MEMORY_EMBEDDING_ENDPOINT=http://127.0.0.1:11434
POLICYPILOT_MEMORY_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Policy dense retrieval uses Qdrant local storage by default. Set a URL to use
# Qdrant Server/Cloud instead; keep the API key out of source control.
POLICYPILOT_QDRANT_PATH=data/tau2/domains/banking_knowledge/vector_index/qdrant
POLICYPILOT_QDRANT_COLLECTION=banking_policy_chunks_v1
# POLICYPILOT_QDRANT_URL=http://127.0.0.1:6333
# POLICYPILOT_QDRANT_API_KEY=
